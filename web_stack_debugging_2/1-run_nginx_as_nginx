#!/usr/bin/env bash
# Configures Nginx to run as the nginx user (master and workers) on port 8080
id nginx >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin nginx
sed -Ei 's/^#?user .*/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/listen 80\([ ;]\)/listen 8080\1/; s/\]:80\([ ;]\)/]:8080\1/' /etc/nginx/sites-available/default
chmod 644 /etc/nginx/nginx.conf
pkill apache2
pkill nginx
sleep 1
touch /run/nginx.pid
chown nginx:nginx /run/nginx.pid
chown -R nginx:nginx /var/log/nginx /var/lib/nginx
su -s /bin/bash nginx -c "nginx"
